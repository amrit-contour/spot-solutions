rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Only verified emails count: an unverified provider must never be able to claim an admin's address.
    function email() { return request.auth.token.email != null && request.auth.token.email_verified == true ? request.auth.token.email.lower() : ""; }
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/config/access)
        && email() in get(/databases/$(database)/documents/config/access).data.admins;
    }
    function isApproved(uid) {
      return exists(/databases/$(database)/documents/access/$(uid))
        && get(/databases/$(database)/documents/access/$(uid)).data.status == 'approved';
    }

    // Invite-only: everyone signs in, admins decide who gets a WhatsApp session.
    match /config/access {
      // Lists admin emails: real accounts only, never anonymous demo visitors.
      allow read: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maxCurators'])
        && request.resource.data.maxCurators is int && request.resource.data.maxCurators >= 1 && request.resource.data.maxCurators <= 100;
    }
    match /access/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // First sign-in: ask for access. Nobody can grant themselves anything.
      allow create: if isOwner(uid) && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'photo', 'status', 'requestedAt']);
      allow update: if isAdmin() && request.resource.data.status in ['approved', 'removed', 'pending']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy']);
    }

    // Worker machines' health. Visible to the admins that server lists in SPOT_ADMIN_EMAILS.
    function isServerAdmin(id) {
      return request.auth != null && email() != ""
        && email() in get(/databases/$(database)/documents/servers/$(id)).data.admins;
    }
    match /servers/{id} {
      allow read: if request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in resource.data.admins;
      match /commands/{cmd} {
        allow read: if isServerAdmin(id);
        allow create: if isServerAdmin(id)
          && request.resource.data.status == 'pending'
          && ((request.resource.data.type in ['restart_worker', 'restart_ollama'])
            // Data tools cross users, so the worker trusts `by`: it has to be the signed-in admin.
            || (request.resource.data.type in ['delete_user_data', 'remove_user', 'wipe_demo']
              && request.resource.data.by is string && request.resource.data.by.lower() == email()));
      }
    }

    // Public per-server summary (hostname, capacity; no logs or admin emails). Servers write it; clients only read.
    match /fleetServers/{id} {
      allow read: if request.auth != null && (isAdmin() || isApproved(request.auth.uid));
    }

    // Each account's login-encryption key. Servers only; no client ever reads or writes it.
    match /vaultKeys/{uid} { allow read, write: if false; }

    // The demo account is a read-only template: demo visitors copy it into their own sandbox.
    // Only the user doc and the collections the clone copies (apps/web/src/lib/demo.ts COLLECTIONS). Never
    // secrets, commands, session, fleet or anything else under it.
    match /users/demo-curator {
      allow read: if request.auth != null;
    }
    match /users/demo-curator/{coll}/{id} {
      allow read: if request.auth != null && coll in ['venues', 'shows', 'comics', 'requests', 'lineups', 'actions', 'notices'];
    }

    match /users/{uid} {
      // Curators can't flip worker-owned fields on their own doc, nor the demo flag: only the anonymous demo
      // clone (apps/web/src/lib/demo.ts) creates a doc with demo: true. A real account never gets it, so
      // the admin "wipe demo" tool can't be pointed at it.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && (request.auth.token.firebase.sign_in_provider == 'anonymous'
          || !request.resource.data.keys().hasAny(['demo', 'demoClonedAt']));
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['waEnabled', 'selfId', 'demo'])
        // demoClonedAt: the anonymous sandbox stamps it when a (re-)clone finishes, nobody else.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['demoClonedAt'])
          || (request.auth.token.firebase.sign_in_provider == 'anonymous' && resource.data.get('demo', false) == true));

      // Written only by the worker (Admin SDK bypasses rules).
      match /session/{doc} { allow read: if isOwner(uid); }
      match /groups/{doc}  { allow read: if isOwner(uid); }
      // list_contacts results, in chunks. Written only by the worker.
      match /contactsImport/{doc} { allow read: if isOwner(uid); }
      match /offers/{doc}  { allow read: if isOwner(uid); }
      // API keys: the curator can set or clear them but never read them back; only the worker (Admin SDK) reads.
      match /secrets/{doc} { allow create, update, delete: if isOwner(uid); }
      match /polls/{doc}   { allow read: if isOwner(uid); }

      // Commands: curator can enqueue pending commands and read results, nothing else.
      match /commands/{id} {
        // Admins only see move_account commands (the Server page): never message or contact payloads.
        allow read: if isOwner(uid) || (isAdmin() && resource.data.type == 'move_account');
        allow create: if isOwner(uid) && isApproved(uid)
          && request.resource.data.status == 'pending'
          && request.resource.data.type in ['connect', 'logout', 'list_groups', 'send_confirmations', 'send_rejections', 'send_action', 'send_offer', 'send_host_poll', 'list_models', 'list_gemini_models', 'test_ai', 'pull_model', 'plan_group_sync', 'sync_group', 'send_message', 'move_account', 'list_contacts', 'pull_group_members'];
        // Admins can move any approved curator's account to another server (Server page → Fleet).
        allow create: if isAdmin() && isApproved(uid)
          && request.resource.data.status == 'pending'
          && request.resource.data.type == 'move_account';
      }

      // Fleet (docs/fleet.md). Lease and vault are written only by servers (Admin SDK bypasses rules).
      match /fleet/lease { allow read: if isOwner(uid) || isAdmin(); }
      match /fleet/vault { allow read: if isOwner(uid) || isAdmin(); }
      // The only thing a client may say: keep this account on that server (or nowhere in particular).
      match /fleet/prefs {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin())
          && request.resource.data.keys().hasOnly(['pinned'])
          && (request.resource.data.get('pinned', null) == null || request.resource.data.pinned is string);
      }

      // Push tokens, one doc per browser. The app registers and removes its own.
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.token == token
          && request.resource.data.keys().hasOnly(['token', 'platform', 'userAgent', 'createdAt', 'lastSeen']);
      }

      match /{coll}/{id} {
        allow read, write: if isOwner(uid) && coll in ['venues', 'shows', 'comics', 'requests', 'lineups', 'actions', 'notices'];
      }
    }
  }
}
