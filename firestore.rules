rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Only verified emails count: an unverified provider must never be able to claim an admin's address.
    function email() { return request.auth.token.email != null && request.auth.token.email_verified == true ? request.auth.token.email.lower() : ""; }
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/config/access)
        && email() in get(/databases/$(database)/documents/config/access).data.admins;
    }
    function isApproved(uid) {
      return exists(/databases/$(database)/documents/access/$(uid))
        && get(/databases/$(database)/documents/access/$(uid)).data.status == 'approved';
    }

    // Invite-only: everyone signs in, admins decide who gets a WhatsApp session.
    match /config/access {
      // Lists admin emails: real accounts only, never anonymous demo visitors.
      allow read: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maxCurators'])
        && request.resource.data.maxCurators is int && request.resource.data.maxCurators >= 1 && request.resource.data.maxCurators <= 100;
    }
    match /access/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // First sign-in: ask for access. Nobody can grant themselves anything.
      allow create: if isOwner(uid) && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'photo', 'status', 'requestedAt']);
      allow update: if isAdmin() && request.resource.data.status in ['approved', 'removed', 'pending']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy']);
    }

    // Signed-in, approved (or admin) and not an anonymous demo visitor: who may see published rosters, their curators' numbers and
    // suggestions. Nothing about rosters is public on the web (docs/plans/comic-app.md).
    function isAllowedUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (isAdmin() || isApproved(request.auth.uid));
    }
    function rosterData(id) { return get(/databases/$(database)/documents/publishedRosters/$(id)).data; }
    function isMaintainer(id) {
      return request.auth != null
        && (rosterData(id).ownerUid == request.auth.uid || request.auth.uid in rosterData(id).coMaintainers);
    }
    function canPublish() {
      return isAdmin() || exists(/databases/$(database)/documents/publishers/$(request.auth.uid));
    }

    // Worker machines' health. Visible to the admins that server lists in NBS_ADMIN_EMAILS.
    function isServerAdmin(id) {
      return request.auth != null && email() != ""
        && email() in get(/databases/$(database)/documents/servers/$(id)).data.admins;
    }
    match /servers/{id} {
      allow read: if request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in resource.data.admins;
      // The Server page says "someone is watching the log" (ms, refreshed every minute). Nothing else is client-writable.
      allow update: if isServerAdmin(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logsWanted'])
        && request.resource.data.logsWanted is number;
      match /commands/{cmd} {
        allow read: if isServerAdmin(id);
        allow create: if isServerAdmin(id)
          && request.resource.data.status == 'pending'
          && ((request.resource.data.type in ['restart_worker', 'restart_ollama', 'update_server'])
            // Data tools cross users, so the worker trusts `by`: it has to be the signed-in admin.
            || (request.resource.data.type in ['delete_user_data', 'remove_user', 'wipe_demo']
              && request.resource.data.by is string && request.resource.data.by.lower() == email()));
      }
    }

    // Public per-server summary (hostname, capacity; no logs or admin emails). Servers write it; clients only read.
    match /fleetServers/{id} {
      allow read: if request.auth != null && (isAdmin() || isApproved(request.auth.uid));
    }

    // Invites: an admin invites an email; the worker approves a matching verified sign-in. Admins only.
    match /invites/{addr} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && addr == addr.lower()
        && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'expireAt'])
        && request.resource.data.createdBy == email()
        && request.resource.data.createdAt is number
        && request.resource.data.expireAt is timestamp;
    }

    // Each account's login-encryption key. Servers only; no client ever reads or writes it.
    match /vaultKeys/{uid} { allow read, write: if false; }

    // Join codes (hashed), the service accounts made for servers, and join rate limits. Cloud Functions only
    // (Admin SDK); no client ever reads or writes them (functions/, docs/multi-server.md).
    match /joinCodes/{hash} { allow read, write: if false; }
    match /serverKeys/{email} { allow read, write: if false; }
    match /joinAttempts/{key} { allow read, write: if false; }
    // Device links (a console asking an admin to approve it): functions only, like join codes.
    match /deviceLinks/{hash} { allow read, write: if false; }
    // Comic edits waiting to be saved to Google Contacts (functions/src/googleContacts.ts). Functions only.
    match /googleSyncQueue/{uid} { allow read, write: if false; }

    // Published rosters (rooms only, shareable fields only). Readable by signed-in allowed users; written by the owner and
    // co-maintainers; only a publisher (or the admin) can create one. Only the owner changes who owns / co-maintains it.
    match /publishedRosters/{id} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser() && canPublish()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.coMaintainers is list
        && request.resource.data.version is int
        && request.resource.data.rooms is list;
      allow update: if isAllowedUser() && isMaintainer(id)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.version is int && request.resource.data.version >= resource.data.version
        && request.resource.data.rooms is list && request.resource.data.coMaintainers is list
        && (resource.data.ownerUid == request.auth.uid
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coMaintainers', 'maintainerNames']));
      allow delete: if isOwner(resource.data.ownerUid);

      // Followers: one doc per follower, written by that person only (the app shows a count). Readable by allowed users.
      match /followers/{fuid} {
        allow read: if isAllowedUser();
        allow create, update: if isAllowedUser() && isOwner(fuid) && exists(/databases/$(database)/documents/publishedRosters/$(id))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'at']) && request.resource.data.uid == fuid;
        allow delete: if isAllowedUser() && isOwner(fuid);
      }

      // Suggestions: anyone allowed can make one (as themselves, pending); the proposer and the maintainers read them;
      // maintainers approve or reject; the proposer can withdraw a pending one.
      match /suggestions/{sid} {
        allow read: if isAllowedUser() && (resource.data.byUid == request.auth.uid || isMaintainer(id));
        allow create: if isAllowedUser() && exists(/databases/$(database)/documents/publishedRosters/$(id))
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['byUid', 'byName', 'target', 'kind', 'before', 'after', 'note', 'baseVersion', 'status', 'createdAt'])
          && request.resource.data.target is map
          && request.resource.data.kind in ['add', 'change', 'remove'];
        allow update: if isAllowedUser() && isMaintainer(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt'])
          && request.resource.data.status in ['approved', 'rejected'];
        allow delete: if isAllowedUser() && ((resource.data.byUid == request.auth.uid && resource.data.status == 'pending') || isMaintainer(id));
      }
    }

    // Who may publish: edited by admins only, readable by allowed users (the app shows who publishes).
    match /publishers/{uid} {
      allow read: if isAllowedUser();
      allow create, update: if isAdmin() && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'addedBy', 'addedAt']);
      allow delete: if isAdmin();
    }

    // The demo account is a read-only template: demo visitors copy it into their own sandbox.
    // Only the user doc and the collections the clone copies (apps/web/src/lib/demo.ts COLLECTIONS). Never
    // secrets, commands, session, fleet or anything else under it.
    match /users/demo-curator {
      allow read: if request.auth != null;
    }
    match /users/demo-curator/{coll}/{id} {
      allow read: if request.auth != null && coll in ['venues', 'shows', 'comics', 'requests', 'lineups', 'actions', 'notices'];
    }

    match /users/{uid} {
      // Curators can't flip worker-owned fields on their own doc, nor the demo flag: only the anonymous demo
      // clone (apps/web/src/lib/demo.ts) creates a doc with demo: true. A real account never gets it, so
      // the admin "wipe demo" tool can't be pointed at it.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && (request.auth.token.firebase.sign_in_provider == 'anonymous'
          || !request.resource.data.keys().hasAny(['demo', 'demoClonedAt']));
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['waEnabled', 'selfId', 'demo', 'agentEnabled'])
        // demoClonedAt: the anonymous sandbox stamps it when a (re-)clone finishes, nobody else.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['demoClonedAt'])
          || (request.auth.token.firebase.sign_in_provider == 'anonymous' && resource.data.get('demo', false) == true));

      // Written only by the worker (Admin SDK bypasses rules). `state` is your WhatsApp, `agent` is the agent number
      // (its QR, status, and what it is waiting for you to answer): both readable by you, writable by no client.
      match /session/{doc} { allow read: if isOwner(uid); }
      match /groups/{doc}  { allow read: if isOwner(uid); }
      // list_contacts results, in chunks. Written only by the worker.
      match /contactsImport/{doc} { allow read: if isOwner(uid); }
      match /offers/{doc}  { allow read: if isOwner(uid); }
      // API keys: the curator can set or clear them but never read them back; only the worker (Admin SDK) reads.
      match /secrets/{doc} { allow create, update, delete: if isOwner(uid); }
      match /polls/{doc}   { allow read: if isOwner(uid); }

      // Commands: curator can enqueue pending commands and read results, nothing else.
      match /commands/{id} {
        // Admins only see move_account commands (the Server page): never message or contact payloads.
        allow read: if isOwner(uid) || (isAdmin() && resource.data.type == 'move_account');
        // Messages page: the result of a chat read holds chat text. The app deletes it as soon as it has it (the expireAt
        // TTL is the backstop). Only the owner can read or delete it, and only these command types.
        allow delete: if isOwner(uid) && resource.data.type in ['list_threads', 'get_thread', 'get_media', 'summarize_thread', 'list_voice_sources', 'parse_roster'];
        allow create: if isOwner(uid) && isApproved(uid)
          && request.resource.data.status == 'pending'
          && request.resource.data.type in ['connect', 'logout', 'list_groups', 'send_confirmations', 'send_rejections', 'send_action', 'send_offer', 'send_host_poll', 'list_models', 'list_gemini_models', 'test_ai', 'pull_model', 'plan_group_sync', 'sync_group', 'send_message', 'move_account', 'list_contacts', 'pull_group_members', 'list_group_members', 'send_lineup_updates', 'reclassify_requests', 'scan_history', 'reconcile_waiting', 'apply_reconcile', 'learn_voice', 'preview_voice', 'apply_follow_up', 'connect_agent', 'logout_agent', 'test_agent', 'list_threads', 'get_thread', 'get_media', 'summarize_thread', 'list_voice_sources', 'parse_roster', 'cleanup_group', 'settle_round', 'send_ask', 'ask_for_spot'];
        // Admins can move any approved curator's account to another server (Server page → Fleet).
        allow create: if isAdmin() && isApproved(uid)
          && request.resource.data.status == 'pending'
          && request.resource.data.type == 'move_account';
        // The curator can stop a running scan_history, and change nothing else on a command.
        allow update: if isOwner(uid)
          && resource.data.type == 'scan_history'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancel']);
      }

      // Fleet (docs/fleet.md). Lease and vault are written only by servers (Admin SDK bypasses rules).
      match /fleet/lease { allow read: if isOwner(uid) || isAdmin(); }
      match /fleet/vault { allow read: if isOwner(uid) || isAdmin(); }
      // The only thing a client may say: keep this account on that server (or nowhere in particular).
      match /fleet/prefs {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin())
          && request.resource.data.keys().hasOnly(['pinned'])
          && (request.resource.data.get('pinned', null) == null || request.resource.data.pinned is string);
      }

      // Google Contacts, kept connected. The encrypted refresh token is users/{uid}/private/google: no rule below names
      // `private`, so no client can read or write it (the catch-all at the end only lists the curator's own collections).
      // The status (connected email, since) is written only by the functions; the owner reads it.
      match /googleLink/{doc} { allow read: if isOwner(uid); }

      // Push tokens, one doc per browser. The app registers and removes its own.
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.token == token
          && request.resource.data.keys().hasOnly(['token', 'platform', 'userAgent', 'createdAt', 'lastSeen', 'app']);
      }

      // A roster shared with one person (docs/plans/comic-app.md): any allowed member can drop a snapshot in another approved member's
      // inbox, as themselves; only the recipient reads or clears it. It is a copy, so nothing here is editable later.
      match /rosterShares/{shareId} {
        allow read, delete: if isOwner(uid);
        allow create: if isAllowedUser() && isApproved(uid) && request.auth.uid != uid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'title', 'note', 'rooms', 'curators', 'createdAt'])
          && request.resource.data.rooms is list && request.resource.data.curators is list && request.resource.data.createdAt is number;
      }

      match /{coll}/{id} {
        allow read, write: if isOwner(uid) && coll in ['venues', 'shows', 'comics', 'requests', 'lineups', 'actions', 'notices'];
        // Nothing BOT Comedy (the comic's own data, owner only; shows are embedded in the room doc): rooms, curators, asks,
        // mySpots, spotAlerts (the worker writes new ones; the comic clears them), watchedGroups, rosterFollows.
        allow read, write: if isOwner(uid) && coll in ['rooms', 'curators', 'asks', 'mySpots', 'regularSpots', 'spotAlerts', 'groupUpdates', 'watchedGroups', 'rosterFollows'];
      }
    }
  }
}
