#!/usr/bin/env bash
# Spot Solutions server control for macOS (Apple Silicon and Intel). No Homebrew or Xcode needed.
#
#   spotctl setup        download Node, Ollama, Gemma and the worker; install launch agents
#   spotctl start|stop   start or stop the whole server (Ollama, worker, console)
#   spotctl restart [worker|ollama|console]
#   spotctl status       one line per service, machine-readable (used by the app)
#   spotctl awake on|off keep running with the lid closed (asks for an admin password)
#   spotctl login on|off start the server automatically when you log in
#   spotctl logs         follow the worker log
#   spotctl uninstall    remove agents and code (keeps data unless --all)
#
# Everything lives in ~/Library/Application Support/SpotSolutions. Re-running setup updates the code.
set -euo pipefail

ROOT="${SPOT_ROOT:-$HOME/Library/Application Support/SpotSolutions}"
APP="$ROOT/app"
DATA="$ROOT/data"
RT="$ROOT/runtime"            # node + ollama binaries we downloaded
LOGS="$ROOT/logs"
AGENTS="$HOME/Library/LaunchAgents"
SRC_URL="${SPOT_SRC_URL:-https://spot-solutions.web.app/dl/spot-solutions.tar.gz}"
MODEL="${GEMMA_MODEL:-gemma3:4b}"
NODE_MAJOR=22
UID_N="$(id -u)"
LABELS=(com.spotsolutions.ollama com.spotsolutions.worker com.spotsolutions.console)
ARCH="$(uname -m)"            # arm64 | x86_64

step() { printf '\n▸ %s\n' "$*"; }
ok()   { printf '  ✓ %s\n' "$*"; }
die()  { printf '  ✗ %s\n' "$*" >&2; exit 1; }

node_bin() { echo "$RT/node/bin/node"; }

find_ollama() {
  for c in "$RT/ollama/ollama" /opt/homebrew/bin/ollama /usr/local/bin/ollama "/Applications/Ollama.app/Contents/Resources/ollama"; do
    [[ -x "$c" ]] && { echo "$c"; return; }
  done
}

ollama_up() { curl -fs --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; }

# Ollama already running from somewhere else (Ollama.app, brew services)? Then we use it and
# don't install our own agent, to avoid two servers fighting over port 11434.
external_ollama() { [[ -f "$ROOT/.external-ollama" ]]; }

plist() { # label program-args... (written as a launch agent that restarts on crash)
  local label="$1"; shift
  local args="" a
  for a in "$@"; do args+="    <string>${a//&/&amp;}</string>"$'\n'; done
  local runatload="false"; [[ -f "$ROOT/.start-at-login" ]] && runatload="true"
  cat > "$AGENTS/$label.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
$args  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$RT/node/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>OLLAMA_KEEP_ALIVE</key><string>24h</string>
    <key>OLLAMA_NUM_PARALLEL</key><string>1</string>
    <key>PUPPETEER_CACHE_DIR</key><string>$ROOT/chrome</string>
    <key>SPOT_DATA_DIR</key><string>$DATA</string>
    <key>SPOT_ENV_FILE</key><string>$APP/apps/worker/.env</string>
    <key>SPOT_OLLAMA_EXE</key><string>$(find_ollama)</string>
  </dict>
  <key>WorkingDirectory</key><string>$APP/apps/worker</string>
  <key>RunAtLoad</key><$runatload/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>90</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$LOGS/${label#com.spotsolutions.}.log</string>
  <key>StandardErrorPath</key><string>$LOGS/${label#com.spotsolutions.}.log</string>
</dict>
</plist>
EOF
}

write_agents() {
  mkdir -p "$AGENTS" "$LOGS"
  local node; node="$(node_bin)"
  if ! external_ollama; then plist com.spotsolutions.ollama "$(find_ollama)" serve; else rm -f "$AGENTS/com.spotsolutions.ollama.plist"; fi
  # The worker waits for a Firebase key; the console is where you add it.
  plist com.spotsolutions.worker /bin/bash -c "while [ ! -f '$DATA/service-account.json' ]; do sleep 10; done; exec '$node' '$APP/apps/worker/node_modules/tsx/dist/cli.mjs' --env-file-if-exists=.env src/index.ts"
  # caffeinate holds a "don't sleep" assertion for exactly as long as the server runs.
  plist com.spotsolutions.console /usr/bin/caffeinate -is "$node" "$APP/apps/worker/console/server.mjs"
}

loaded() { launchctl print "gui/$UID_N/$1" >/dev/null 2>&1; }
running() { launchctl print "gui/$UID_N/$1" 2>/dev/null | grep -q "state = running"; }

cmd_setup() {
  mkdir -p "$APP" "$DATA" "$RT" "$LOGS" "$ROOT/chrome"
  step "Node.js $NODE_MAJOR"
  if [[ ! -x "$(node_bin)" ]]; then
    local v plat
    v="$(curl -fsSL https://nodejs.org/dist/index.json | /usr/bin/python3 -c "import sys,json;print([x['version'] for x in json.load(sys.stdin) if x['version'].startswith('v$NODE_MAJOR.')][0])")"
    plat="darwin-$([[ $ARCH == arm64 ]] && echo arm64 || echo x64)"
    rm -rf "$RT/node" && mkdir -p "$RT/node"
    curl -fSL --progress-bar "https://nodejs.org/dist/$v/node-$v-$plat.tar.gz" | tar -xz -C "$RT/node" --strip-components 1
  fi
  ok "Node $("$(node_bin)" -v)"

  step "Ollama"
  if ollama_up && [[ ! -f "$AGENTS/com.spotsolutions.ollama.plist" ]]; then
    touch "$ROOT/.external-ollama"; ok "Using the Ollama already running on this Mac"
  else
    rm -f "$ROOT/.external-ollama"
    if [[ -z "$(find_ollama)" ]]; then
      mkdir -p "$RT/ollama"
      curl -fSL --progress-bar https://github.com/ollama/ollama/releases/latest/download/ollama-darwin.tgz | tar -xz -C "$RT/ollama"
      [[ -x "$RT/ollama/ollama" ]] || die "Ollama download didn't contain the expected binary"
    fi
    ok "Ollama at $(find_ollama)"
  fi

  step "Spot Solutions code"
  curl -fsSL "$SRC_URL" | tar -xz -C "$APP"
  ok "Version $(cat "$APP/VERSION" 2>/dev/null || echo dev)"
  (cd "$APP" && PATH="$RT/node/bin:$PATH" PUPPETEER_CACHE_DIR="$ROOT/chrome" "$RT/node/bin/npx" -y pnpm@9.15.4 install --frozen-lockfile --filter "@spot/worker...") || die "Installing dependencies failed"

  step "Configuration"
  local env="$APP/apps/worker/.env"
  if [[ ! -f "$env" ]]; then
    cat > "$env" <<EOF
FIREBASE_SERVICE_ACCOUNT=$DATA/service-account.json
FIREBASE_PROJECT_ID=
OLLAMA_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
SPOT_ADMIN_EMAILS=${ADMIN_EMAILS:-}
WWEBJS_DATA=$DATA/wwebjs
CHROME_PATH=
EOF
  fi
  chmod 600 "$env"; chmod 700 "$DATA"
  ok "Keys go in through the console (Spot Server app, or http://localhost:7420)"

  step "Background services"
  touch "$ROOT/.start-at-login"
  write_agents
  cmd_start
  step "Gemma ($MODEL)"
  for _ in $(seq 1 30); do ollama_up && break; sleep 1; done
  "$(find_ollama)" pull "$MODEL" || die "Downloading $MODEL failed"
  ok "Done. Open the console to add your Firebase key."
}

cmd_start() {
  [[ -f "$AGENTS/com.spotsolutions.console.plist" ]] || write_agents
  for l in "${LABELS[@]}"; do
    [[ -f "$AGENTS/$l.plist" ]] || continue
    loaded "$l" || launchctl bootstrap "gui/$UID_N" "$AGENTS/$l.plist" 2>/dev/null || true
    launchctl kickstart "gui/$UID_N/$l" 2>/dev/null || true
  done
  ok "Server started"
}

cmd_stop() {
  for l in "${LABELS[@]}"; do loaded "$l" && launchctl bootout "gui/$UID_N/$l" 2>/dev/null || true; done
  ok "Server stopped"
}

cmd_restart() {
  local which="${1:-all}"
  if [[ "$which" == all ]]; then cmd_stop; cmd_start; return; fi
  launchctl kickstart -k "gui/$UID_N/com.spotsolutions.$which" && ok "Restarted $which"
}

cmd_status() {
  local installed=no; [[ -x "$(node_bin)" && -f "$APP/apps/worker/package.json" ]] && installed=yes
  echo "installed=$installed"
  for l in "${LABELS[@]}"; do
    local s=stopped
    if [[ $l == com.spotsolutions.ollama ]] && external_ollama; then ollama_up && s=external || s=stopped
    elif running "$l"; then s=running; elif loaded "$l"; then s=starting; fi
    echo "${l#com.spotsolutions.}=$s"
  done
  echo "key=$([[ -f "$DATA/service-account.json" ]] && echo yes || echo no)"
  echo "awake=$([[ "$(pmset -g | awk '/SleepDisabled/{print $2}')" == 1 ]] && echo on || echo off)"
  echo "login=$([[ -f "$ROOT/.start-at-login" ]] && echo on || echo off)"
  echo "version=$(cat "$APP/VERSION" 2>/dev/null || echo none)"
}

cmd_awake() {
  case "${1:-}" in
    on)  /usr/bin/osascript -e 'do shell script "pmset -a disablesleep 1 && pmset -c sleep 0 && pmset -c disksleep 0" with administrator privileges with prompt "Spot Server wants to keep this Mac running with the lid closed."' >/dev/null && ok "Mac stays awake, even with the lid closed" ;;
    off) /usr/bin/osascript -e 'do shell script "pmset -a disablesleep 0 && pmset -c sleep 1" with administrator privileges with prompt "Spot Server wants to restore normal sleep."' >/dev/null && ok "Normal sleep restored" ;;
    *) die "usage: spotctl awake on|off" ;;
  esac
}

cmd_login() {
  case "${1:-}" in
    on) touch "$ROOT/.start-at-login" ;;
    off) rm -f "$ROOT/.start-at-login" ;;
    *) die "usage: spotctl login on|off" ;;
  esac
  write_agents
  ok "Start at login: $1"
}

cmd_uninstall() {
  cmd_stop
  rm -f "$AGENTS"/com.spotsolutions.*.plist
  rm -rf "$APP" "$RT" "$ROOT/chrome" "$LOGS"
  [[ "${1:-}" == --all ]] && rm -rf "$ROOT"
  ok "Removed. ${1:+Everything, including your WhatsApp session and keys.}"
}

case "${1:-}" in
  setup) cmd_setup ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) shift; cmd_restart "${1:-all}" ;;
  status) cmd_status ;;
  awake) shift; cmd_awake "${1:-}" ;;
  login) shift; cmd_login "${1:-}" ;;
  logs) tail -n 100 -F "$LOGS/worker.log" ;;
  uninstall) shift; cmd_uninstall "${1:-}" ;;
  *) sed -n '2,13p' "$0"; exit 1 ;;
esac
