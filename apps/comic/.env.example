VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public OAuth web client (Google Cloud Console, APIs & Services, Credentials). Used by "Keep connected" for Google Contacts.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Web push key pair (Firebase console, Project settings, Cloud Messaging, Web Push certificates). Needed for spot alerts on a device.
VITE_FIREBASE_VAPID_KEY=
