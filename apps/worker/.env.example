# Path to a Firebase service-account key (Project settings → Service accounts → Generate key)
FIREBASE_SERVICE_ACCOUNT=./service-account.json
FIREBASE_PROJECT_ID=your-project-id
# Local Gemma via Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=90000
# Optional fallback: Gemma hosted on the Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_GEMMA_MODEL=gemma-3-27b-it
# Where WhatsApp sessions persist (keep on a disk that survives reboots)
WWEBJS_DATA=./.wwebjs_auth
# Use system Chromium instead of Puppeteer's bundled one (Docker / ARM)
CHROME_PATH=
# Delay between outgoing messages
SEND_JITTER_MIN_MS=3000
SEND_JITTER_MAX_MS=8000
