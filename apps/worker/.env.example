# Path to this server's own service-account key. Create one per device: deploy/new-server-key.sh <device>
FIREBASE_SERVICE_ACCOUNT=./service-account.json
FIREBASE_PROJECT_ID=your-project-id
# Comma-separated emails that see the Server page and are approved automatically
SPOT_ADMIN_EMAILS=
# Starting limit on approved curators (default 6; admins can change it later on the Server page)
# SPOT_MAX_CURATORS=

# Local Gemma via Ollama. Set SPOT_NO_LOCAL_MODEL=1 for a Gemini-only server (no Ollama).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=90000
SPOT_NO_LOCAL_MODEL=0
# Optional: a server-wide Gemini key (curators can also add their own in Settings → AI)
GEMINI_API_KEY=

# Multi-server: a stable id (default: generated once and kept in WWEBJS_DATA/server.json),
# the most accounts this machine should host (default: from its memory), and the login vault bucket.
# SPOT_SERVER_ID=
# SPOT_MAX_ACCOUNTS=
# SPOT_STORAGE_BUCKET=

# Where WhatsApp logins persist (keep on a disk that survives reboots)
WWEBJS_DATA=./.wwebjs_auth
# Use system Chromium instead of Puppeteer's bundled one (Docker / ARM)
CHROME_PATH=
# Delay between outgoing messages
SEND_JITTER_MIN_MS=3000
SEND_JITTER_MAX_MS=8000
